DJANGO_DEBUG=true
# Generate a unique secret before deployment. The development default is ephemeral.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_PATH=var/db.sqlite3
# Optional production PostgreSQL connection URL; never commit a populated value.
# DATABASE_URL=
# FUEL_CSV_PATH=/etc/secrets/fuel-prices-for-be-assessment.csv
AUTO_INITIALIZE_DATA=false
REFRESH_FUEL_PRICES=false
# PORT is supplied by the hosting platform; local default remains 8000.
# WEB_CONCURRENCY=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-actual-hostname
# Optional CSV default; Docker sets this to its read-only /app/input mount.
# FUEL_PRICES_CSV=data/fuel-prices-for-be-assessment.csv
OSRM_BASE_URL=https://router.project-osrm.org
# Deliberately opt in after reading the usage policy in README.md.
GEOCODING_ENABLED=false
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Required for public Nominatim: replace with your real contact address or URL.
GEOCODING_USER_AGENT=
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=20
GEOCODING_CACHE_DAYS=30
ROUTE_CACHE_SECONDS=86400
MAX_STATION_DETOUR_MILES=20
DEPARTURE_PRICE_RADIUS_MILES=20
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Local failure demonstration only; disabled when DEBUG=false.
ENABLE_FAILURE_DEMO=false
# HTTPS deployment only; local HTTP defaults remain false/0.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true
# Enable only when a trusted proxy overwrites X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_SSL_HEADER=true
